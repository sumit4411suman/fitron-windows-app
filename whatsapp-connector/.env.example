# ---------------------------------------------------------------------------
# Fitron WhatsApp Connector — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# One of: api (HTTP only), worker (WhatsApp sessions + queue), all (both in one process; fine for small installs)
RUN_MODE=all

# Postgres and Redis. docker-compose.yml sets these for the containers; they are only needed when running outside Docker.
DATABASE_URL=postgresql://wa:CHANGE_ME_DB_PASSWORD@localhost:5432/wa_connector
REDIS_URL=redis://localhost:6379
# Used by docker-compose.yml to create the database user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Administration key: creates gyms and their API keys. Server-to-server only; never put it in a browser.
# Generate: openssl rand -hex 32
WA_CONNECTOR_MASTER_KEY=GENERATE_A_STRONG_SECRET

# Encrypts the WhatsApp authentication data at rest (AES-256-GCM). Changing it invalidates every saved session (gyms rescan).
# Generate: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=GENERATE_A_STRONG_SECRET

# WhatsApp engine: baileys (WebSocket, no browser, a few MB per gym) or wwebjs (whatsapp-web.js: real WhatsApp Web in
# headless Chromium, ~300-500 MB RAM per linked gym). Switching engines means every gym scans a new QR code.
WA_ENGINE=baileys
# The Chromium wwebjs launches (only used with WA_ENGINE=wwebjs); the Docker image ships one here.
CHROMIUM_PATH=/usr/bin/chromium-browser

# Where the WhatsApp sessions and queued media live. In Docker these are named volumes mounted at these paths.
SESSION_STORAGE_PATH=/data/whatsapp-sessions
MEDIA_STORAGE_PATH=/data/media

# Message pacing, per gym. Conservative on purpose; raising them does not make WhatsApp happier.
MAX_MESSAGES_PER_MINUTE=10
MAX_MESSAGES_PER_HOUR=100
MAX_MESSAGES_PER_DAY=500
MAX_QUEUE_SIZE_PER_GYM=500
# Random pause between two messages from the same gym (milliseconds)
MIN_SEND_GAP_MS=3000
MAX_SEND_GAP_MS=8000
# A queued message that could not be sent within this time (WhatsApp disconnected) fails instead of waiting forever
MESSAGE_MAX_AGE_HOURS=24
# How often the worker re-checks a queued message while the gym's WhatsApp is offline (seconds)
OFFLINE_RETRY_SECONDS=30
# How many sends the worker runs at the same time, across gyms
WORKER_CONCURRENCY=4
# Max upload size for documents and images (bytes). 10 MB.
MAX_MEDIA_BYTES=10485760

# Consent. Opt-out keywords are matched on the whole incoming message, case-insensitive.
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE,CANCEL,OPTOUT,OPT OUT
OPT_IN_KEYWORDS=START,SUBSCRIBE,OPTIN,OPT IN
# Reply sent once when a member opts out (empty = no reply)
OPT_OUT_REPLY=You will no longer receive messages from us. Reply START to opt back in.
# Transactional messages (receipts, expiry reminders) normally also stop after an opt-out. Set true only where that is legal
# and expected for your gym's contracts.
ALLOW_TRANSACTIONAL_AFTER_OPT_OUT=false
# Set true to require an explicit opt-in record even for transactional messages.
REQUIRE_OPT_IN_FOR_TRANSACTIONAL=false

# Default country for phone numbers written without a country code (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY=IN

# Browsers allowed to call the API directly (the Fitron app server does not need this; it is server-to-server).
CORS_ORIGIN=https://www.fitron.in
# Public address, used in the OpenAPI document and nginx
PUBLIC_URL=https://wa-api.fitron.in
DOMAIN=wa-api.fitron.in
LETSENCRYPT_EMAIL=admin@fitron.in

# HTTP rate limit per API key (requests per minute)
API_RATE_LIMIT_PER_MINUTE=120
# QR codes waiting for a scan are abandoned after this many minutes without anyone watching the events stream
QR_IDLE_MINUTES=5
# How long WhatsApp Web may stay disconnected before the session is marked SESSION_EXPIRED (minutes)
RECONNECT_GIVE_UP_MINUTES=30
