# Postgres connection string for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitron"
# A hosted database (Supabase and the like) instead of the Postgres container in deploy/docker-compose.yml, which sets
# DATABASE_URL itself. Put the connection string here, in deploy/.env, between single quotes (deploy/README.md step 11).
# For Supabase use the "Session pooler" string (port 5432) and add the certificate:
#   postgres://postgres.<project>:<password>@<host>:5432/postgres?sslmode=verify-full&sslrootcert=/certs/supabase-ca.crt
# "sslmode=require" alone does not work with Supabase: its certificates come from its own authority.
EXTERNAL_DATABASE_URL=""
# Hosting on Vercel instead (deploy/VERCEL.md): DATABASE_URL is the Supabase pooler address, and these three help it work there.
# DIRECT_URL: the session-mode address (port 5432), used only to apply database migrations; the build uses it, so it must be IPv4.
# DATABASE_CA: the text of Supabase's certificate (Settings > Database > SSL), instead of a file, which Vercel has no disk for.
# DATABASE_POOL_MAX: connections one running copy of the app may hold; 3 to 5 suits Vercel. Empty means the default of 10 (3 on Vercel).
DIRECT_URL=""
DATABASE_CA=""
DATABASE_POOL_MAX=""

# Daily jobs: a scheduler calls GET /api/jobs/daily with "Authorization: Bearer <CRON_SECRET>" each morning
CRON_SECRET=""

# WhatsApp Business (official, from Meta). Each gym connects its OWN number with the "Connect with Meta" button in
# Settings > WhatsApp (Embedded Signup); Fitron keeps that gym's token (sealed with BIOMETRIC_KEY) and sends from its number.
# One Meta app serves every gym: set it up once (docs/WHATSAPP-BUSINESS.md) and put its values here.
META_APP_ID=""                 # the Meta app's id
META_ES_CONFIG_ID=""           # its WhatsApp Embedded Signup configuration id
WHATSAPP_APP_SECRET=""         # the Meta app's secret (also signs the delivery webhook)
WHATSAPP_VERIFY_TOKEN=""       # any string; the same one is typed into the webhook in the Meta app
# Webhook URL for Meta (set once, for the whole app): https://<your-domain>/api/webhooks/whatsapp
# Optional fallback: ONE number shared by every gym that has not connected its own.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# Linked-phone WhatsApp connector (Settings > WhatsApp > "Link WhatsApp"): the self-hosted service in whatsapp-connector/,
# deployed once with Docker (its README; e.g. https://wa-api.fitron.in). WA_CONNECTOR_URL is its address and WA_CONNECTOR_KEY
# its WA_CONNECTOR_MASTER_KEY, which Fitron uses only to create each gym on the connector; every gym then gets a key of its
# own, kept sealed in that gym's settings. Both are needed before any gym can link a phone.
WA_CONNECTOR_URL=""
WA_CONNECTOR_KEY=""

# Razorpay UPI Autopay (Settings > UPI Autopay > "Live").
# Webhook URL for Razorpay: https://<your-domain>/api/webhooks/razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# "Continue with Google" on the login and sign-up pages. Google Cloud console > APIs & Services >
# Credentials > Create OAuth client ID > Web application, with authorised redirect URI
# https://<your-domain>/auth/google/callback. Without them the Google button is hidden.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Signs the short-lived Google sign-in cookies. Generate with: openssl rand -hex 32
# (falls back to CRON_SECRET when empty).
AUTH_SECRET=""

# Fitron AI (the assistant on /ai), the AI Coach and the Fitron Assistant chat on the home page. Without a key the brief and
# risk list still work, and the home page chat answers from its built-in facts (src/lib/domain/assistant.ts).
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# Biometric door devices (ZKTeco / eSSL, ADMS mode). Devices call https://<your-domain>/iclock/…
# Key that encrypts stored fingerprint and face templates. Required in production; keep it safe,
# templates can't be read without it. Generate with: openssl rand -hex 32
BIOMETRIC_KEY=""

# AI Trainer push reminders (Web Push) to members' phones when the app is closed. Make the pair once with:
#   npx web-push generate-vapid-keys
# Without them the app only reminds while it is open. VAPID_SUBJECT is a mailto: or https: contact for push services.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@fitron.in"

# The public address of the site, used in links inside emails. deploy/docker-compose.yml sets it
# from DOMAIN, so only set it when running the app some other way.
APP_URL=""

# FITRON's own billing of gyms (Gym Accounting plans and extra branches) and of AI Trainer members is Razorpay only.
# Who may open the FITRON team console (/fitron-admin): emails of FITRON team logins, comma separated.
# Each must also be a user of some gym on this server.
FITRON_ADMIN_EMAILS=""
# Fitron's own Razorpay account (NOT the gym's RAZORPAY_* keys above, which are for a gym's member autopay).
# Plans renew themselves as Razorpay Subscriptions (the 14 live plan ids are in src/lib/domain/razorpay-plans.ts;
# test mode needs its own plans), and one-time add-ons are single payments. Listed prices include GST.
# Without these keys payments run in demo mode (no money moves; a live server refuses to take any payment).
# In Razorpay turn on Subscriptions with Cards, UPI (AutoPay) and
# Net banking: the checkout shows every method enabled on the account; FITRON does not limit them.
# Webhook: https://<your-domain>/api/webhooks/fitron-billing with events subscription.activated,
# subscription.charged, subscription.halted, subscription.pending, subscription.cancelled,
# subscription.completed, payment.captured and payment.failed.
FITRON_RAZORPAY_KEY_ID=""
FITRON_RAZORPAY_KEY_SECRET=""
FITRON_RAZORPAY_WEBHOOK_SECRET=""
# Trying payments with Razorpay TEST keys (rzp_test_...): no real money moves, and the app finds or makes matching test
# plans in the test account by itself. A live server refuses test keys unless this is 1, because a test payment is free
# and would give a real plan away. Set it only while you try payments; with live keys leave it empty.
FITRON_ALLOW_TEST_PAYMENTS=""
# Seller details printed on Fitron's tax invoices to gyms. The address and GSTIN are also shown on the public Contact page
# (and its "Company details" link in the footer); the legal name appears there once one of them is set.
FITRON_LEGAL_NAME="Fitron Technologies"
FITRON_GSTIN=""
FITRON_ADDRESS=""

# Member documents. Without S3_* they are kept on the server's disk in STORAGE_DIR (default ./storage);
# on a single server that's fine as long as the folder is on a persistent disk and backed up.
STORAGE_DIR=""
# Any S3-compatible private bucket (Cloudflare R2's free tier works; so does Supabase Storage, see deploy/README.md step 11):
# endpoint without the bucket name. S3_REGION is "auto" for R2; Supabase needs its project's region, such as ap-south-1.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email (SMTP) for website enquiries, sign-up confirmation, password reset (emailed link and six-digit code), passwordless
# sign-in ("Email me a code or sign-in link" on /login) and payment emails. Any provider works
# (Amazon SES, Zoho Mail, Brevo, Google Workspace). Without SMTP_HOST, emails are only logged (and the passwordless
# sign-in is hidden on a production server).
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=the SMTP login shown under SMTP & API > SMTP (looks like
# xxxx@smtp-brevo.com), SMTP_PASS=an SMTP key (starts with xsmtpsib-). Keep the key in this file or the host's environment
# settings only, never in the code, and verify the sender in MAIL_FROM in Brevo first.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Sender shown on emails; the domain must be verified with your SMTP provider.
MAIL_FROM="FITRON <hello@fitron.in>"
# Where trial requests and contact-form messages from fitron.in are sent.
ENQUIRY_TO="hello@fitron.in"
# Google Analytics 4 measurement ID for the public website ("G-XXXXXXXXXX"). Empty: no analytics code is loaded at all.
# With an ID set, it still runs only for visitors who tick "Analytics" in the cookie choices (docs/ANALYTICS.md).
GA_MEASUREMENT_ID=""
# Where Help & support tickets raised in the console are sent.
SUPPORT_TO="support@fitron.in"
# Who is emailed when the server hits an error nobody caught: comma separated, needs SMTP_HOST. At most one email
# per kind of error per hour and ten an hour in all. Empty: errors are only written to the log (docker compose logs app).
ERROR_ALERT_TO=""
# Content-Security-Policy: what the browser may load and run on FITRON's pages. "report" (the default) only logs what
# it would block (docker compose logs app | grep csp.violation); "enforce" blocks it; "off" sends no policy.
# Run in report mode for a few days of real use, then set "enforce" when the log is quiet.
CSP_MODE="report"
# Optional: 10-digit numbers shown as WhatsApp / Call cards in Settings › Help & support.
SUPPORT_WHATSAPP=""
SUPPORT_PHONE=""
