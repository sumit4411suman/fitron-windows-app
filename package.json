{
  "name": "fitron",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "prisma generate && prisma generate --schema prisma/schema.local.prisma",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate && prisma generate --schema prisma/schema.local.prisma",
    "db:seed": "prisma db seed",
    "setup": "tsx scripts/setup.ts",
    "test:local": "tsx scripts/test-local.ts",
    "db:local-schema": "tsx scripts/local-schema.ts && prisma generate --schema prisma/schema.local.prisma",
    "e2e:local": "tsx scripts/e2e-local.ts",
    "licence:keygen": "tsx scripts/licence-keygen.ts",
    "licence:issue": "tsx scripts/licence-issue.ts",
    "desktop:bundle": "tsx scripts/desktop-bundle.ts",
    "desktop:build": "tsx scripts/desktop-bundle.ts && tauri build --config src-tauri/tauri.bundle.conf.json",
    "desktop:smoke": "tsx scripts/desktop-smoke.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^12.11.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "next": "^16.3.8",
    "nodemailer": "^10.0.14",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "2.12.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
